# Supabase
VITE_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTO con un "Authorized redirect URI" configurado en Google:
# https://<tu-dominio-de-vercel>/api/google-callback
GOOGLE_REDIRECT_URI=

# URL pública de la app (sin / al final), usada para armar links (WhatsApp, redirects)
APP_BASE_URL=http://localhost:5173

# Passcode simple para entrar a /admin (un solo usuario, no es auth robusta)
ADMIN_PASSCODE=
