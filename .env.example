# Supabase (proyecto "agenda-psicologa")
VITE_SUPABASE_URL=https://mmqfsbtnejbbmcgmpvas.supabase.co
SUPABASE_URL=https://mmqfsbtnejbbmcgmpvas.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTO con un "Authorized redirect URI" configurado en Google:
# https://<tu-dominio-de-vercel>/api/google-callback
GOOGLE_REDIRECT_URI=

# URL pública de la app (sin / al final), usada para armar links (WhatsApp, redirects)
APP_BASE_URL=http://localhost:5173

# Correos de Google autorizados a entrar a /admin, separados por coma
ADMIN_EMAILS=

# Secreto para firmar la cookie de sesión del admin — cualquier cadena
# larga y aleatoria sirve, no necesita significar nada
SESSION_SECRET=
